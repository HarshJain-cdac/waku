{
  "title": "package.freeze result",
  "description": "FRS F35, F36: the package's files and whether it is frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documents",
    "frozen",
    "frozen_at_version",
    "lacking"
  ],
  "properties": {
    "documents": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,40}$"
          },
          "doc_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "frozen": {
      "type": "boolean"
    },
    "frozen_at_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "lacking": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
