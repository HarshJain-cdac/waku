{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact.pr",
  "description": "What pr.build leaves on the record. waku/nam/guardrails.py keys each item for the duplicate-PR check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "missing",
    "items"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "missing": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "qty"
        ],
        "properties": {
          "material_code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          },
          "qty": {
            "type": "number",
            "minimum": 0
          },
          "uom": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "precedents": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "header": {
      "type": "object",
      "description": "The PR header (policy/pr_fields.json): from the case, the estimate, the guided form or the officer.",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 300
      }
    },
    "officer_fields": {
      "type": "object",
      "description": "What the officer gave, kept for later runs.",
      "additionalProperties": {
        "type": "string",
        "maxLength": 120
      }
    }
  }
}
