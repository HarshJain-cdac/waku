{
  "title": "NAM document versions (nam.v1)",
  "description": "GET /v1/nam/documents/{doc}/versions: every version, oldest first, and the delete if there was one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "doc_id",
    "case_id",
    "latest_version",
    "versions",
    "deleted"
  ],
  "properties": {
    "version": {
      "const": "nam.v1"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^DOC-[0-9a-f]{12}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^NAM-\\d{4}-\\d{4,8}$"
    },
    "latest_version": {
      "type": "integer",
      "minimum": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc_version",
          "filename",
          "mime",
          "bytes",
          "sha256",
          "pages",
          "text_pages",
          "ocr_pages",
          "uploaded_by",
          "uploaded_at",
          "reason",
          "run_id"
        ],
        "properties": {
          "doc_version": {
            "type": "integer",
            "minimum": 1
          },
          "filename": {
            "type": "string",
            "maxLength": 200
          },
          "mime": {
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "image/png",
              "image/jpeg",
              "image/tiff"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "text_pages": {
            "type": "integer",
            "minimum": 0
          },
          "ocr_pages": {
            "type": "integer",
            "minimum": 0
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        }
      }
    },
    "deleted": {
      "$ref": "#/$defs/deleted"
    }
  },
  "$defs": {
    "deleted": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "at",
        "by",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
