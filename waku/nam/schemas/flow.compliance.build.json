{
  "title": "compliance.build result",
  "description": "FRS F26: the requirements, numbered for the department's answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "complete",
    "requirements",
    "undecided"
  ],
  "properties": {
    "category": {
      "enum": [
        "goods",
        "services",
        "works"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "id",
          "text",
          "basis",
          "source",
          "apply",
          "why"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "maxLength": 60
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "basis": {
            "type": "string",
            "maxLength": 200
          },
          "source": {
            "enum": [
              "policy",
              "department"
            ]
          },
          "apply": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 300
          },
          "issued": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "case_key"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 2000
                },
                "case_key": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            }
          }
        }
      }
    },
    "undecided": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
