{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact.package",
  "description": "What package.freeze leaves on the record: the documents in the package. waku/nam/guardrails.py checks the case's mandatory documents are there (R24).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "documents"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,40}$"
          },
          "doc_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "precedents": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "validation_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
