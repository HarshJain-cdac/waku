  "capture": {
    "about": "PR Creation Flow 1(c), 1(e): the details need capture asks after the questions that tell the past tenders apart, per form, in order. A field is a key or {key, text, per_item, options_from, options, options_in_days}: 'text' is the question ({item} is the item it is asked for); 'per_item' asks it for each item of a request with several, before the next item starts (the rest are asked once, for the whole need, at the end). Every question offers choices, never examples in its words: 'options_from' the values the matching past tenders carry (related.<field>, or past_quantities.qty / past_quantities.uom from the KG's price records), most common first; then 'options', this policy's own; 'options_in_days' dates that many days from today. The officer may still type their own value; 'I don't know' is always offered and takes the most common suggestion, marked default.",
    "Goods": [
      {
        "key": "quantity",
        "per_item": true,
        "text": "How many {item} are needed?",
        "options_from": "past_quantities.qty"
      },
      {
        "key": "uom",
        "per_item": true,
        "text": "In which unit are {item} counted?",
        "options_from": "past_quantities.uom",
        "options": [
          "Nos",
          "Set",
          "Kg",
          "Mtr",
          "Ltr",
          "Lot"
        ]
      },
      {
        "key": "required_by",
        "text": "By when are they needed?",
        "options_in_days": [
          30,
          60,
          90
        ]
      },
      {
        "key": "location",
        "text": "Which plant, unit or area will they be used in?",
        "options_from": "related.department"
      },
      {
        "key": "purpose",
        "text": "What will they be used for?",
        "options": [
          "Replacement of worn or failed items",
          "Maintenance spares",
          "New installation",
          "Project requirement"
        ]
      }
    ],
    "Services": [
      {
        "key": "term_months",
        "text": "For how many months is the contract?",
        "options": [
          "6",
          "12",
          "24",
          "36"
        ]
      },
      {
        "key": "start_date",
        "text": "From when should it start?",
        "options_in_days": [
          30,
