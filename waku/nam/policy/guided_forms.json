    },
    "quantity": {
      "label": "Quantity",
      "type": "number",
      "mandatory": true,
      "need": "quantity"
    },
    "uom": {
      "label": "Unit of measure (Nos, Kg, Mtr, Set)",
      "type": "text",
      "mandatory": true
    },
    "term_months": {
      "label": "Contract period in months",
      "type": "number",
      "mandatory": true,
      "need": "term"
    },
    "required_by": {
      "label": "Required-by date (YYYY-MM-DD)",
      "type": "date",
      "mandatory": true
    },
    "start_date": {
      "label": "Start date (YYYY-MM-DD), if fixed",
      "type": "date"
    },
    "location": {
      "label": "Location (plant, unit or area)",
      "type": "text",
      "mandatory": true,
      "need": "location"
    },
    "justification": {
      "label": "Business justification",
      "type": "text",
      "mandatory": true
    },
    "purpose": {
      "label": "Purpose, if different from the justification",
      "type": "text"
    }
