{
  "status": "DRAFT for review: drafted from FRS 3.1.1 (available information), entity E2, R28 and the need.guided_form instructions; Diagram B is an image and its exact fields are to be checked",
  "fields": {
    "codified": {
      "label": "Is the item codified (has a material code)?",
      "type": "radio",
      "options": [
        "Codified",
        "Uncodified"
      ],
      "mandatory": true,
      "subtype": true
    },
    "material_code": {
      "label": "Material code",
      "type": "text",
      "mandatory_if": {
        "field": "codified",
        "equals": "Codified"
      },
      "na_if": {
        "field": "codified",
        "equals": "Uncodified"
      }
    },
    "service_type": {
      "label": "Which kind of service is it?",
      "type": "radio",
      "options": [
        "Repetitive (AMC, manpower)",
        "Consultancy",
        "Non-consultancy"
      ],
      "mandatory": true,
      "subtype": true
    },
    "service_code": {
      "label": "Service code, if there is one",
      "type": "text"
    },
    "budget": {
      "label": "Is the budget Capital or Revenue?",
      "type": "radio",
      "options": [
        "Capital",
        "Revenue"
      ],
      "mandatory": true
    },
    "impanelment": {
      "label": "Is the work within or outside the impanelment?",
      "type": "radio",
      "options": [
        "Within impanelment",
        "Outside impanelment"
      ]
    },
    "description": {
      "label": "Describe the item, service or work",
      "type": "text",
      "mandatory": true
    },
    "specification": {
      "label": "Technical specification of the item",
      "type": "text",
      "mandatory_if": {
        "field": "codified",
        "equals": "Uncodified"
      },
      "na_if": {
        "field": "codified",
        "equals": "Codified"
      }
    },
    "scope_of_work": {
      "label": "Scope of work",
      "type": "text",
      "mandatory": true
    },
    "line_items": {
      "label": "Line items with quantities, if you have them",
      "type": "text"
    },
    "previous_contract": {
      "label": "The previous contract or tender for this work, if known",
      "type": "text"
    },
    "worker_categories": {
      "label": "Worker categories (skilled, semi-skilled, unskilled)",
      "type": "text",
      "mandatory_if": {
        "field": "service_type",
        "equals": "Repetitive (AMC, manpower)"
      }
    },
    "head_count": {
      "label": "Number of workers",
      "type": "number",
      "mandatory_if": {
        "field": "service_type",
        "equals": "Repetitive (AMC, manpower)"
